{
  "name": "discovery-to-spec",
  "version": "0.3.1",
  "description": "A lightweight, repo-native workflow for design and product teams: frame → research → options → decide → spec → handoff. Markdown docs, a human decision gate, and agent skills for Claude Code and Cursor.",
